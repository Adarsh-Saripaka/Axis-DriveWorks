PORT=5000
FRONTEND_URL=http://localhost:5173
# Perplexity (server-side only. NEVER put this in the frontend, render.yaml or git)
PERPLEXITY_API_KEY=your_perplexity_key_here
PERPLEXITY_MODEL=sonar-pro
# Cost guard: max NEW AI lookups per day (cache hits are free)
DAILY_LOOKUP_LIMIT=100
# Protects reservation-management endpoints
ADMIN_TOKEN=change_me_to_a_long_random_string
